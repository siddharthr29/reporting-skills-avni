# Copy to tools/.env (gitignored) and fill in. Ask your lead for the values — never commit them.

# --- SSH tunnel to the READ replica ---
SSH_KEY=~/.ssh/<your-infra-key>.pem
SSH_USER=<ssh-user>
SSH_JUMP_HOST=<SSH_JUMP_HOST>
READ_DB_HOST=<READ_DB_HOST>
LOCAL_PORT=5433

# --- Postgres (through the tunnel) ---
PGUSER=<read-user>
PGPASSWORD=<read-password>
PGDATABASE=openchs

# --- Metabase ---
METABASE_URL=https://reporting.avniproject.org
METABASE_API_KEY=<metabase-api-key>

# --- Superset ---
SUPERSET_URL=https://reporting-superset.avniproject.org
SUPERSET_USER=<your-superset-username>
SUPERSET_PASSWORD=<your-superset-password>

# Optional: psql binary if not on PATH (e.g. /opt/homebrew/opt/postgresql@16/bin/psql)
PSQL=psql
